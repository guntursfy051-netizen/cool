--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// Settings
_G.dis = CFrame.new(0,0,5)   -- Offset from boss
local skillCooldown = 1       -- Seconds between skill casts

--// Character handling (updates after respawn)
local hrp
local function updateCharacter(char)
    hrp = char:WaitForChild("HumanoidRootPart")
end
updateCharacter(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(updateCharacter)

--// Anti-ragdoll setup
local function antiRagdoll()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.PlatformStand = false
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BodyPosition") or v:IsA("BodyGyro") or v:IsA("BodyVelocity") then
                v:Destroy()
            end
        end
    end
end

--// Skills Remote
local SkillsRemote = ReplicatedStorage:WaitForChild("Assets")
    :WaitForChild("Remotes"):WaitForChild("Skills"):WaitForChild("SKill")

--// Function to use skills
local function useSkills()
    local skillList = {
        {"Training Strike","Training Strike","InnateTechnique"},
        {"Anti-Magic Greatsword","Anti-Magic Cleave","Sword"},
        {"Choso","Blood Shot"},
        {"Choso","Blood Ascension"},
        {"Choso","Piercing Blood"},
        {"Choso","Hemorrhage"}
    }

    for _, args in ipairs(skillList) do
        SkillsRemote:FireServer(unpack(args))
        task.wait(0.3)
    end
end

--// Function to teleport & face boss, returns true if teleport occurred
local function handleBosses(bossFolder)
    for _, boss in pairs(bossFolder:GetChildren()) do
        local bossHRP = boss:FindFirstChild("HumanoidRootPart")
        local bossHumanoid = boss:FindFirstChildOfClass("Humanoid")
        if bossHRP and bossHumanoid and bossHumanoid.Health > 0 then
            -- Teleport
            hrp.CFrame = bossHRP.CFrame * _G.dis
            -- Face boss
            local direction = (bossHRP.Position - hrp.Position).Unit
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + direction)
            return true
        end
    end
    return false
end

--// Main auto loop for a map
local function autoBossMap(bossMap)
    getgenv().auto = true
    local lastSkillTime = 0

    while getgenv().auto do
        task.wait(0.1)
        antiRagdoll()
        local bossFound = false

        local bossesFolder = workspace:WaitForChild("Map")
            :WaitForChild("Boss"):WaitForChild(bossMap):WaitForChild("Bosses")

        local teleported = handleBosses(bossesFolder)
        if teleported then
            bossFound = true
            -- Only use skills if teleported and cooldown passed
            if tick() - lastSkillTime >= skillCooldown then
                useSkills()
                lastSkillTime = tick()
            end
        end

        if not bossFound then
            getgenv().auto = false
            warn("No active bosses found in "..bossMap..". Auto stopped.")
        end
    end
end

