-- SETTINGS
_G.offset = Vector3.new(0, 0, 5)
getgenv().auto = false
getgenv().bossMode = "Metro"

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local player = Players.LocalPlayer

local bv
local loopRunning = false

-- Anti Knockback
local function addAntiKnockback(hrp)
    if bv then bv:Destroy() end
    
    bv = Instance.new("BodyVelocity")
    bv.Name = "AntiKnockback"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.P = 125000
    bv.Parent = hrp
end

-- Get Target Boss
local function getTargetBoss()
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end
    
    local bossFolder = map:FindFirstChild("Boss")
    if not bossFolder then return nil end
    
    local area = bossFolder:FindFirstChild(getgenv().bossMode)
    if not area then return nil end
    
    local bosses = area:FindFirstChild("Bosses")
    if not bosses then return nil end
    
    for _, boss in pairs(bosses:GetChildren()) do
        if boss:IsA("Model") 
        and boss:FindFirstChild("HumanoidRootPart") 
        and boss:FindFirstChild("Humanoid") 
        and boss.Humanoid.Health > 0 then
            return boss
        end
    end
    
    return nil
end

----------------------------------------------------------------
-- AUTO SKILL (REAL REMOTE VERSION)
----------------------------------------------------------------
local SkillsRemote = game:GetService("ReplicatedStorage")
    :WaitForChild("Assets")
    :WaitForChild("Remotes")
    :WaitForChild("Skills")
    :WaitForChild("SKill")

local function useSkills()

    local skillList = {
        {"Training Strike","Training Strike","InnateTechnique"},
        {"Anti-Magic Greatsword","Anti-Magic Cleave","Sword"},
        {"Choso","Blood Shot"},
        {"Choso","Blood Ascension"},
        {"Choso","Piercing Blood"},
        {"Choso","Hemorrhage"}
    }

    for _, args in ipairs(skillList) do
        SkillsRemote:FireServer(unpack(args))
        task.wait(0.3) -- small delay between skills
    end
end

-- Main Loop
local function startLoop()
    if loopRunning then return end
    loopRunning = true

    task.spawn(function()
        while getgenv().auto do
            task.wait(0.1)
            pcall(function()
                local char = player.Character
                if not char then return end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                if not hrp:FindFirstChild("AntiKnockback") then
                    addAntiKnockback(hrp)
                end
                
                local target = getTargetBoss()
                if target then
                    local targetHRP = target.HumanoidRootPart
                    local desiredPos = targetHRP.Position + _G.offset
hrp.Position = desiredPos

-- Lock rotation every frame
hrp.CFrame = CFrame.lookAt(hrp.Position, targetHRP.Position)

                    
                    -- AUTO SKILLS
                    useSkills()
                end
            end)
        end
        
        if bv then
            bv:Destroy()
        end
        
        loopRunning = false
    end)
end

