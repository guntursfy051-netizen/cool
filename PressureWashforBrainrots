--// SETTINGS
local HOME_POS = CFrame.new(-25, 16, -141)

local BrainrotsFolder = workspace:WaitForChild("Game"):WaitForChild("Brainrots")

--// RARITIES
local Rarities = {
    OG = {
        "Meowl","Avocadini Antilopini","Salamino Pinguino","Cachorrito Melonito",
        "Noo My Examine","Yes My Examine","Graipussi Medussi",
        "Ketchuru And Musturu","Ketupat Kepat"
    },
    Admin = {
        "Noobini Pizzanini","Sigma Boy","Quesadilla Crocodila",
        "Alessio","Nuclearo Dinosauro","Tik Tak Sahur"
    },
    Divine = {
        "Agarrini La Pallini","Ben","Happy Banana Meme","Illuminati",
        "Nyan Cat","Pepe","Skibidi Toilet","Trollface"
    }
}

--// STATES
local Enabled = {OG=false, Admin=false, Divine=false}
local AutoCash = false

local player = game.Players.LocalPlayer

--// TP
local function teleport(cf)
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = cf
    end
end

--// COLLECT PROMPT
local function collect(model)
    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            fireproximityprompt(v)
        end
    end
end

--// GET ROOT
local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("PrimaryPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

--// FIND TARGET
local function findTarget(list)
    for _, obj in pairs(BrainrotsFolder:GetChildren()) do
        if table.find(list, obj.Name) then
            return obj
        end
    end
end

--// BRAINROT FARM LOOP
task.spawn(function()
    while true do
        for rarity, state in pairs(Enabled) do
            if state then
                local target = findTarget(Rarities[rarity])
                if target then
                    local root = getRoot(target)
                    if root then
                        teleport(root.CFrame)
                        task.wait(0.3)

                        collect(target)

                        task.wait(0.2)
                        teleport(HOME_POS)
                        task.wait(0.5)
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

--// AUTO CASH LOOP
task.spawn(function()
    while true do
        if AutoCash then
            for i = 1, 50 do
                local args = {"Collect", i}
                game:GetService("ReplicatedStorage")
                    :WaitForChild("Events")
                    :WaitForChild("PlotHandler")
                    :FireServer(unpack(args))

                task.wait(0.05) -- adjust speed if needed
            end
        end
        task.wait(0.5)
    end
end)

--// GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 200)
frame.Position = UDim2.new(0.05, 0, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true

local function createButton(name, y, callback)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(1, -10, 0, 40)
    b.Position = UDim2.new(0, 5, 0, y)
    b.Text = name.." : OFF"
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)

    b.MouseButton1Click:Connect(function()
        callback(b)
    end)
end

--// BUTTONS
createButton("OG", 5, function(btn)
    Enabled.OG = not Enabled.OG
    btn.Text = "OG : "..(Enabled.OG and "ON" or "OFF")
end)

createButton("Admin", 50, function(btn)
    Enabled.Admin = not Enabled.Admin
    btn.Text = "Admin : "..(Enabled.Admin and "ON" or "OFF")
end)

createButton("Divine", 95, function(btn)
    Enabled.Divine = not Enabled.Divine
    btn.Text = "Divine : "..(Enabled.Divine and "ON" or "OFF")
end)

createButton("Auto Cash", 140, function(btn)
    AutoCash = not AutoCash
    btn.Text = "Auto Cash : "..(AutoCash and "ON" or "OFF")
end)
